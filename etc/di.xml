<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="cloudgento_rma_request_listing_data_source" xsi:type="string">
                    Cloudgento\Rma\Model\ResourceModel\WithdrawalRequest\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Cloudgento\Rma\Model\ResourceModel\WithdrawalRequest\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">cloudgento_rma_request</argument>
            <argument name="resourceModel" xsi:type="string">
                Cloudgento\Rma\Model\ResourceModel\WithdrawalRequest
            </argument>
        </arguments>
    </type>
    <!--
        Assisted support (Cloudgento_Support): our own extension, so no licence; the shop's
        support token identifies it. Harmless when Cloudgento_Support is not installed.
    -->
    <type name="Cloudgento\Support\Model\Extensions">
        <arguments>
            <argument name="extensions" xsi:type="array">
                <item name="rma" xsi:type="array">
                    <item name="name" xsi:type="string">Withdrawal (EU Directive 2023/2673)</item>
                    <item name="module" xsi:type="string">Cloudgento_Rma</item>
                    <item name="section" xsi:type="string">cloudgento_rma</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
